{
  "version": 8,
  "name": "Simple OSM",
  "sources": {
    "osm-tiles": {
      "type": "raster",
      "tiles": [
        "https://tile.openstreetmap.org/{z}/{x}/{y}.png"
      ],
      "minzoom": 1,
      "maxzoom": 22,
      "tileSize": 256,
      "attribution": "è¢Ì<a href=\"https://www.openstreetmap.org/copyright\" target=\"_blank\">OpenStreetMap</a> contributors"
    },
    "IRI-source": {
      "type": "vector",
      "tiles": [
        "pmtiles://http://127.0.0.1:8080/data/IRI.pmtiles/{z}/{x}/{y}"
      ],
      "minzoom": 8,
      "maxzoom": 20
    }
  },
  "layers": [
    {
      "id": "osm-layer",
      "type": "raster",
      "source": "osm-tiles",
      "minzoom": 0,
      "maxzoom": 24,
      "layout": { "visibility": "visible" },
      "paint": {
        "raster-brightness-min": 0,
        "raster-brightness-max": 0.5,
        "raster-saturation": -0.9
      }
    },
    {
      "id": "IRI01-layer",
      "type": "line",
      "source": "IRI-source",
      "source-layer": "IRI01",
      "layout": { "visibility": "visible" },
      "paint": {
        "line-color": [
          "case",
          ["in", "Very Good", ["string", ["get", "description"], ""]], "#0000FF",
          ["in", "Fairly Good", ["string", ["get", "description"], ""]], "#00FFFF",
          ["in", "Good", ["string", ["get", "description"], ""]], "#1E90FF",
          ["in", "Standard (Upper)", ["string", ["get", "description"], ""]], "#00FF80",
          ["in", "Standard (Lower)", ["string", ["get", "description"], ""]], "#00FF00",
          ["in", "Slightly Rough", ["string", ["get", "description"], ""]], "#ADFF2F",
          ["in", "Very Rough", ["string", ["get", "description"], ""]], "#FFA500",
          ["in", "Extremely Rough", ["string", ["get", "description"], ""]], "#FF0000",
          ["in", "Rough", ["string", ["get", "description"], ""]], "#FFFF00",
          "#000000"
        ],
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          10, 1,
          15, 3
        ]
      }
    },
    {
      "id": "IRI02-layer",
      "type": "line",
      "source": "IRI-source",
      "source-layer": "IRI02",
      "layout": { "visibility": "none" },
      "paint": {
        "line-color": [
          "case",
          ["in", "Very Good", ["string", ["get", "description"], ""]], "#0000FF",
          ["in", "Fairly Good", ["string", ["get", "description"], ""]], "#00FFFF",
          ["in", "Good", ["string", ["get", "description"], ""]], "#1E90FF",
          ["in", "Standard (Upper)", ["string", ["get", "description"], ""]], "#00FF80",
          ["in", "Standard (Lower)", ["string", ["get", "description"], ""]], "#00FF00",
          ["in", "Slightly Rough", ["string", ["get", "description"], ""]], "#ADFF2F",
          ["in", "Very Rough", ["string", ["get", "description"], ""]], "#FFA500",
          ["in", "Extremely Rough", ["string", ["get", "description"], ""]], "#FF0000",
          ["in", "Rough", ["string", ["get", "description"], ""]], "#FFFF00",
          "#000000"
        ],
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          10, 1,
          15, 3
        ]
      }
    }
  ]
}